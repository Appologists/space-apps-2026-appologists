{
  "name": "lunar-landing-site-navigator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NASA Space Apps 2026, Lunar Landing Site Navigator: compare Moon landing sites and dates by sunlight, Earth visibility and terrain.",
  "scripts": {
